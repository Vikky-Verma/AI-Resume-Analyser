# Database (Neon/Postgres connection string)
DATABASE_URL=

# Auth
JWT_SECRET=

# Cloudinary (resume file storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare (used for AI analysis — confirm which service this is if unsure)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# GitHub (used for portfolio/project import feature)
GITHUB_TOKEN=

# Email (Brevo — used for OTP verification and the contact form)
BREVO_API_KEY=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AlgoVerse
# Inbox that contact form submissions get forwarded to (defaults to SMTP_FROM_EMAIL if unset)
CONTACT_TO_EMAIL=

# Server
PORT=8000
NODE_ENV=development
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Analysis {
  id              String   @id @default(cuid())
  resumeId        String   @unique
  score           Float
  atsScore        Float
  domain          String?
  experienceLevel String?
  skills          String[]
  missingSkills   String[]
  suggestions     String[]
  resume          Resume   @relation(fields: [resumeId], references: [id])
}

model Resume {
  id             String   @id @default(cuid())

  originalName   String
  filePath       String

  extractedText  String?

  uploadedAt     DateTime @default(now())

  userId         String
  user           User @relation(fields: [userId], references: [id])

  analysis       Analysis?
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  
  resume    Resume[]
  mockInterviews MockInterview[]
  companyProgress CompanyPrepProgress[]
  applications    Application[]
  portfolio       Portfolio?
  builderResumes  BuilderResume[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  company     String
  role        String
  link        String?
  notes       String?

  // applied | oa | interview | offer | rejected
  status      String   @default("applied")

  deadline    DateTime?

  // Array of { status, at } — status change log
  statusHistory Json   @default("[]")

  // Order within its status column (drag-and-drop position)
  position    Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Portfolio {
  id          String   @id @default(cuid())

  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])

  slug        String   @unique

  headline    String?
  bio         String?
  skills      String[]

  // Array of { name, techStack: [], description, link, github }
  projects    Json     @default("[]")

  // { github, linkedin, website, twitter }
  links       Json     @default("{}")

  isPublic    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BuilderResume {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  title       String   @default("Untitled Resume")

  // Which visual template + which company preset was used to build this
  templateId  String   @default("classic")
  companyId   String   @default("general")

  // { fullName, role, email, phone, location, linkedin, github, website }
  personalInfo Json    @default("{}")

  summary     String?  @default("")

  // [{ id, role, company, location, startDate, endDate, current, bullets: [] }]
  experience  Json     @default("[]")

  // [{ id, school, degree, field, startDate, endDate, gpa }]
  education   Json     @default("[]")

  // [{ id, name, techStack: [], description, bullets: [], link, github }]
  projects    Json     @default("[]")

  // [{ id, category, items: [] }]
  skills      Json     @default("[]")

  // [{ id, text }]
  achievements Json    @default("[]")

  // [{ id, name, issuer, date }]
  certifications Json  @default("[]")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompanyPrepProgress {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  company     String   // company slug, e.g. "google"

  // question ids (e.g. "google-1") the user has marked as solved
  solvedIds   String[]

  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([userId, company])
}

model MockInterview {
  id              String    @id @default(cuid())

  userId          String
  user            User      @relation(fields: [userId], references: [id])

  resumeId        String?

  company         String
  role            String
  level           String    // Fresher | Intermediate | Advanced

  status          String    @default("in_progress") // in_progress | completed

  // Array of { type, label, score, questions: [{ question, answer, score, feedback }] }
  rounds          Json

  overallScore    Float?
  overallFeedback String?
  verdict         String?

  createdAt       DateTime  @default(now())
  completedAt     DateTime?
}